{
  "identifier": "remote-access",
  "description": "Allow terramap.github.io to access Tauri IPC",
  "windows": ["main"],
  "remote": {
    "urls": ["https://terramap.github.io/*"]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://terraria.wiki.gg/*" }]
    }
  ]
}
