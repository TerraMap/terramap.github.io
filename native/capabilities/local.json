{
  "identifier": "local-dev",
  "description": "Allow the bundled frontend (and the localhost dev server) to access Tauri IPC",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://terramap.github.io/*" },
        { "url": "https://terraria.wiki.gg/*" },
        { "url": "https://www.paypal.com/*" },
        { "url": "https://github.com/terramap/*" }
      ]
    }
  ]
}
