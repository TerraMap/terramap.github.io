{
  "identifier": "local-dev",
  "description": "Allow localhost dev server to access Tauri IPC",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://terraria.wiki.gg/*" }]
    }
  ]
}
